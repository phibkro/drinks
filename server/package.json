{
  "name": "drinks-server",
  "version": "1.0.0",
  "description": "Backend for the drinks app",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed": "wrangler d1 execute drinks-db --file ./data/seed.sql",
    "start": "npm run build && NODE_ENV=production node ./dist/index.js",
    "migrate": "wrangler d1 migrations apply drinks-db",
    "run:drinksToJSON": "node --loader ts-node/esm scripts/csvToJSON.ts src/data/cleaned_all_drinks.csv",
    "run:createDrinksSeed": "node --loader ts-node/esm scripts/createDrinksSeed.ts",
    "run:createIngredientAndMeasuresSeed": "node --loader ts-node/esm scripts/createIngredientsAndMeasuresSeeds.ts",
    "prisma:reset": "prisma migrate reset",
    "prisma:prototype": "prisma db push",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^4.9.4",
    "@as-integrations/cloudflare-workers": "^1.0.2",
    "@prisma/adapter-d1": "^5.19.1",
    "@prisma/client": "^5.19.1",
    "graphql": "^16.8.1",
    "prisma": "^5.19.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240919.0",
    "@graphql-tools/mock": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "@types/node": "^20.16.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "wrangler": "^3.78.7"
  }
}
