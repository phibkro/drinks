{
  "name": "drinks",
  "version": "1.0.0",
  "description": "Share your drink recipes and review others!",
  "private": true,
  "type": "module",
  "workspaces": ["app", "server"],
  "scripts": {
    "dev": "CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 CLOUDFLARE_API_TOKEN=local ALCHEMY_STAGE=development alchemy dev",
    "plan": "ALCHEMY_STAGE=production alchemy plan",
    "deploy": "ALCHEMY_STAGE=production alchemy deploy",
    "infra:typecheck": "tsc --noEmit",
    "check": "bun run app:build && bun run server:typecheck && bun run server:test && bun run infra:typecheck",
    "app:build": "cd app && bun run build",
    "app:test": "cd app && bun run test",
    "server:typecheck": "cd server && bun run typecheck",
    "server:test": "cd server && bun run test",
    "server:seed": "cd server && bun run seed"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phibkro/drinks"
  },
  "author": "@eskildov, @philipbk, @solvhold",
  "license": "ISC",
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@types/node": "^20.19.40",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
