{
  "name": "drinks",
  "version": "1.0.0",
  "description": "Share your drink recipes and review others!",
  "private": true,
  "scripts": {
    "install:all": "cd app && npm install && cd ../server && bun install",
    "dev": "concurrently -n server,app -c blue,green \"npm:server:dev\" \"npm:app:dev\"",
    "app:dev": "cd app && npm run dev",
    "app:build": "cd app && npm run build",
    "app:preview": "cd app && npm run preview",
    "app:test": "cd app && npm run test",
    "server:dev": "cd server && bun run dev",
    "server:start": "cd server && bun run start",
    "server:seed": "cd server && bun run seed",
    "server:migrate": "cd server && bun run migrate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phibkro/drinks"
  },
  "author": "@eskildov, @philipbk, @solvhold",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
